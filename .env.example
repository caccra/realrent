# PostgreSQL connection string (Neon, Supabase, Railway, or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/realrent?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Storage (property photos) — Project Settings → API
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Flutterwave (Stage 2 — sandbox keys, https://dashboard.flutterwave.com)
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# Secret shared with whatever scheduler calls GET /api/cron/rent-cycle
CRON_SECRET="generate-with: openssl rand -hex 24"
