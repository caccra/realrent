# PostgreSQL connection string (Neon, Supabase, Railway, or local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/kezavi?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Storage (property photos) — Project Settings → API
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Flutterwave (Mobile Money payments — sandbox keys at https://dashboard.flutterwave.com)
# FLUTTERWAVE_SECRET_HASH is a webhook secret YOU set in the Flutterwave
# dashboard (Settings -> Webhooks), then paste the same value here — it's
# not the same as the API secret key. Webhook URL to configure there:
# <your-domain>/api/webhooks/flutterwave
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_SECRET_HASH=""

# Secret shared with whatever scheduler calls GET /api/cron/rent-cycle
CRON_SECRET="generate-with: openssl rand -hex 24"

# Resend (email notifications) — https://resend.com/api-keys
# EMAIL_FROM must be on a domain you've verified in Resend (or use their
# onboarding domain "onboarding@resend.dev" for testing before that's done).
RESEND_API_KEY=""
EMAIL_FROM="Kezavi <notifications@yourdomain.com>"

# Africa's Talking (SMS notifications) — https://account.africastalking.com
# AFRICASTALKING_USERNAME is "sandbox" for a test app, or your live app's
# username otherwise — the SMS host is chosen automatically based on this.
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""

# Shown on the public Contact page — optional, leave blank to hide that row.
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""
